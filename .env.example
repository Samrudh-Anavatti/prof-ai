# Copy to .env and fill in. Never commit .env; this repo is public.
APP_ENV=local
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=rg-prof-ai
# Comma-separated emails for the Azure budget alerts (used by scripts/deploy-infra.sh)
BUDGET_CONTACT_EMAILS=
# Content store (used by the prof CLI; authenticates with your az login)
STORAGE_ACCOUNT_URL=https://stprofaicjzzqh.blob.core.windows.net/
# Users and sign-in (used by `prof users`; authenticates with your az login)
COSMOS_ENDPOINT=https://cosmos-prof-ai.documents.azure.com:443/
EXTERNAL_TENANT_ID=c01293ab-8f78-46af-aa73-1c8fd5a88555
# Tutor chat (local runs call Luna with your az login; each message costs tokens)
FOUNDRY_ENDPOINT=https://foundry-prof-ai.cognitiveservices.azure.com/
CHAT_DEPLOYMENT=gpt-5.6-luna
CHAT_ENABLED=true
CHAT_DAILY_USER_USD=0.50
CHAT_DAILY_GLOBAL_USD=1.50
CHAT_TOKENS_PER_MINUTE=50000
# Optional: Ollama Cloud models for your own test chats and evals (never for students)
OLLAMA_API_KEY=
# Local only: act as this user (their External ID object id) without signing in
DEV_USER_ID=
